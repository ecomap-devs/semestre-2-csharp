@{
    ViewData["Title"] = "Login";
}

<div class="min-h-screen flex items-center justify-center bg-gray-100">
    <div class="bg-white shadow-lg rounded-lg p-8 w-full max-w-md">
        <div class="flex justify-center mb-6">
            <img src="~/images/logo2.png" alt="Logo EcoMapBrasil" class="h-16 w-auto" />
        </div>
        <h1 class="text-2xl font-bold text-center mb-6">Login</h1>

        <form>
            <div class="mb-4">
                <label for="nome" class="block text-gray-700 mb-2">Nome</label>
                <input type="text" id="nome" name="nome" required class="w-full px-4 py-2 border rounded focus:outline-none focus:ring-2 focus:ring-green-600" />
            </div>
            <div class="mb-4">
                <label for="email" class="block text-gray-700 mb-2">E-mail</label>
                <input type="email" id="email" name="email" required class="w-full px-4 py-2 border rounded focus:outline-none focus:ring-2 focus:ring-green-600" />
            </div>
            <div class="mb-6">
                <label for="senha" class="block text-gray-700 mb-2">Senha</label>
                <input type="password" id="senha" name="senha" required class="w-full px-4 py-2 border rounded focus:outline-none focus:ring-2 focus:ring-green-600" />
            </div>
            <div class="flex justify-between items-center mb-4">
                <a asp-controller="Home" asp-action="Index" class="text-green-700 hover:underline">Voltar</a>
                <button type="submit" class="bg-green-600 text-white px-6 py-2 rounded hover:bg-green-700 transition">Entrar</button>
            </div>
        </form>
    </div>
</div>
