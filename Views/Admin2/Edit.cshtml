@model EcoMapBrasil.Models.Usuario


@{
    ViewBag.Title = "Editar Usuário";
}

<h2>Editar Usuário</h2>

<form method="post">

    <input type="hidden" name="id" value="@Model.IdUsuario" />

    <div class="form-group">
        <label>Nome de Usuário</label>
        <input name="username" class="form-control" value="@Model.Nome" required />
    </div>

    <div class="form-group mt-2">
        <label>Email</label>
        <input type="email" name="email" class="form-control" value="@Model.Email" required />
    </div>

    <button class="btn btn-primary mt-3">Salvar Alterações</button>
    <a href="/User" class="btn btn-secondary mt-3">Cancelar</a>

</form>
