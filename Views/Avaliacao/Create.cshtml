@{



    ViewData["Title"] = "Deixar Avaliação";

    Layout = null;
}
<link rel="stylesheet" href="~/css/novaavaliacao.css" />

<h2>Deixar Avaliação</h2>

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()

    <div class="form-group">
        <label for="comentario">Comentário</label>
        <textarea id="comentario" name="comentario" class="form-control" required></textarea>
    </div>

    <div class="form-group">
        <label for="nota">Nota</label>
        <input id="nota" name="nota" type="number" min="1" max="5" class="form-control" required />
    </div>

    <div class="form-actions">
        <!-- Voltar: history.back() para retornar à página anterior -->
        <button type="button" class="btn btn-secondary" onclick="history.back(); return false;">Voltar</button>

        <!-- Enviar -->
        <button type="submit" class="btn btn-primary">Enviar</button>
    </div>
</form>
