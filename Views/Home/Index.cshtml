<!-- Scripts -->
@section Scripts {
    <script>
        const backToTopButton = document.getElementById('backToTop');
        window.addEventListener('scroll', () => {
            if (window.pageYOffset > 300) {
                backToTopButton.classList.remove('hidden');
            } else {
                backToTopButton.classList.add('hidden');
            }
        });
        backToTopButton.addEventListener('click', () => {
            window.scrollTo({ top: 0, behavior: 'smooth' });
        });

        // scroll suave
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                const targetId = this.getAttribute('href');
                if (targetId === '#') return;
                const targetElement = document.querySelector(targetId);
                if (targetElement) {
                    targetElement.scrollIntoView({ behavior: 'smooth' });
                }
            });
        });
    </script>

    <script>
    (function () {
        const slidesContainer = document.querySelector('.slides');
        if (!slidesContainer) return;

        const slides = Array.from(slidesContainer.querySelectorAll('.slide'));
        if (slides.length === 0) return;

        let current = 0;
        const intervalMs = 5000;
        let timer = null;
        let isPaused = false;

        // Inicializa estado
        function showSlide(index) {
            slides.forEach((s, i) => {
                s.classList.toggle('active', i === index);
            });
            updateDots(index);
            current = index;
        }

        // Autoplay
        function start() {
            timer = setInterval(() => {
                if (isPaused) return;
                const nextIndex = (current + 1) % slides.length;
                showSlide(nextIndex);
            }, intervalMs);
        }

        function pause() { isPaused = true; }
        function resume() { isPaused = false; }

        function restart() {
            clearInterval(timer);
            isPaused = false;
            start();
        }

        // Pausa ao passar o mouse e em telas touch ao pressionar
        slidesContainer.addEventListener('mouseenter', pause);
        slidesContainer.addEventListener('mouseleave', resume);
        slidesContainer.addEventListener('touchstart', () => pause(), { passive: true });
        slidesContainer.addEventListener('touchend', () => resume(), { passive: true });

        // Inicializa primeira exibição e autoplay
        showSlide(0);
        start();

        // Expõe funções para debug no console (opcional)
        window.__ecoSlideshow = { showSlide, pause, resume, restart };
    })();
    </script>

    <script>
        (function () {
            const container = document.getElementById('bioma-chart');
            if (!container) return;

            const rows = Array.from(container.querySelectorAll('.chart-row'));
            if (rows.length === 0) return;

            const fills = rows.map(r => r.querySelector('.bar-fill'));
            const values = fills.map(f => Number(f.dataset.value || 0));
            const max = Math.max(...values, 1);

            function placeLabel(trackEl, fillEl, labelEl, pct) {
                const trackRect = trackEl.getBoundingClientRect();
                const trackWidth = Math.max(trackRect.width, 1);
                // calc fill width in px
                const fillPx = Math.round((pct / 100) * trackWidth);
                // text width
                labelEl.style.left = '0px';
                labelEl.style.opacity = '0';
                labelEl.style.color = '#064e3b';
                const textWidth = Math.ceil(labelEl.getBoundingClientRect().width);

                // margin from edge
                const margin = 8;

                if (fillPx >= textWidth + 24) {
                    // cabe dentro da barra: posicionar alinhado à direita dentro do preenchimento
                    let leftPx = Math.max(fillPx - textWidth - margin, 6);
                    // impedir que o texto ultrapasse o início do track
                    leftPx = Math.max(leftPx, 6);
                    labelEl.style.left = leftPx + 'px';
                    labelEl.style.color = '#ffffff';
                } else {
                    // posicionar fora, logo à direita do preenchimento
                    let leftPx = fillPx + margin;
                    // evitar que ultrapasse o final do track (fica dentro do container porque track tem padding-right)
                    leftPx = Math.min(leftPx, trackWidth - textWidth - 6);
                    labelEl.style.left = leftPx + 'px';
                    labelEl.style.color = '#064e3b';
                }
                // tornar visível
                labelEl.style.opacity = '1';
            }

            function animateOnce() {
                fills.forEach((el, i) => {
                    const value = Number(el.dataset.value || 0);
                    const pct = Math.min(Math.max((value / max) * 100, 0), 100);

                    const track = el.parentElement;
                    const label = track.querySelector('.bar-value');

                    setTimeout(() => {
                        el.style.transition = 'width 900ms cubic-bezier(.2,.8,.2,1)';
                        el.style.width = pct + '%';

                        // garantir repaint antes de medir e posicionar
                        requestAnimationFrame(() => {
                            // definir texto (antes de medir)
                            if (label) label.textContent = value + ' mil';
                            // posicionar usando pixels
                            placeLabel(track, el, label, pct);
                        });
                    }, i * 140);
                });
            }

            const observer = new IntersectionObserver((entries, obs) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        animateOnce();
                        obs.disconnect();
                    }
                });
            }, { threshold: 0.3 });

            observer.observe(container);
        })();
    </script>

    <script src="~/js/timeline.js" asp-append-version="true"></script>
    <script src="~/js/bioma-pie.js" asp-append-version="true"></script>
}

