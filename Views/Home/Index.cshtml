<!-- Evolução do Desmatamento -->
<section id="dados" class="py-16 bg-gray-100">
    <div class="container mx-auto px-4">
        <h2 class="text-3xl font-bold text-center mb-6 text-gray-800">Evolução do Desmatamento no Brasil</h2>
        <p class="text-center text-gray-600 max-w-2xl mx-auto mb-12">
            Veja como o desmatamento tem evoluído ao longo dos anos em diferentes biomas brasileiros.
        </p>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
            <div class="bg-white p-6 rounded-xl shadow-md">
                <h3 class="text-xl font-bold text-gray-800 mb-4">Área Desmatada por Bioma</h3>

                <div class="h-100 bg-gray-100 rounded-lg p-6">
                    <div id="bioma-chart" class="w-full mx-auto">
                        <div class="chart-rows space-y-4">
                            <div class="chart-row flex items-center">
                                <div class="label w-36 text-left pr-4 text-green-800 font-semibold">Amazônia</div>
                                <div class="bar-track flex-1 h-12 bg-white rounded-md relative overflow-hidden">
                                    <div class="bar-fill bg-emerald-800 h-full rounded-md" data-value="780" style="width:0"></div>
                                    <div class="bar-value absolute top-1/2 transform -translate-y-1/2 text-sm font-semibold opacity-0"></div>
                                </div>
                            </div>

                            <div class="chart-row flex items-center">
                                <div class="label w-36 text-left pr-4 text-green-800 font-semibold">Cerrado</div>
                                <div class="bar-track flex-1 h-12 bg-white rounded-md relative overflow-hidden">
                                    <div class="bar-fill bg-emerald-800 h-full rounded-md" data-value="520" style="width:0"></div>
                                    <div class="bar-value absolute top-1/2 transform -translate-y-1/2 text-sm font-semibold opacity-0"></div>
                                </div>
                            </div>

                            <div class="chart-row flex items-center">
                                <div class="label w-36 text-left pr-4 text-green-800 font-semibold">Mata Atlântica</div>
                                <div class="bar-track flex-1 h-12 bg-white rounded-md relative overflow-hidden">
                                    <div class="bar-fill bg-emerald-800 h-full rounded-md" data-value="320" style="width:0"></div>
                                    <div class="bar-value absolute top-1/2 transform -translate-y-1/2 text-sm font-semibold opacity-0"></div>
                                </div>
                            </div>

                            <div class="chart-row flex items-center">
                                <div class="label w-36 text-left pr-4 text-green-800 font-semibold">Caatinga</div>
                                <div class="bar-track flex-1 h-12 bg-white rounded-md relative overflow-hidden">
                                    <div class="bar-fill bg-emerald-800 h-full rounded-md" data-value="150" style="width:0"></div>
                                    <div class="bar-value absolute top-1/2 transform -translate-y-1/2 text-sm font-semibold opacity-0"></div>
                                </div>
                            </div>

                            <div class="chart-row flex items-center">
                                <div class="label w-36 text-left pr-4 text-green-800 font-semibold">Pampa</div>
                                <div class="bar-track flex-1 h-12 bg-white rounded-md relative overflow-hidden">
                                    <div class="bar-fill bg-emerald-800 h-full rounded-md" data-value="60" style="width:0"></div>
                                    <div class="bar-value absolute top-1/2 transform -translate-y-1/2 text-sm font-semibold opacity-0"></div>
                                </div>
                            </div>
                        </div>

                        <div class="chart-footer mt-6 flex items-center justify-between text-sm text-green-800 font-semibold">
                            <div class="chart-scale flex-1 text-left">0</div>
                            <div class="chart-scale flex-1 text-center">200</div>
                            <div class="chart-scale flex-1 text-center">400</div>
                            <div class="chart-scale flex-1 text-center">600</div>
                            <div class="chart-scale flex-1 text-right">mil km²</div>
                        </div>

                        <!-- donut + linha -->
                        <div class="bioma-pie-container mt-6">
                            <h4 class="text-lg font-semibold text-gray-700 mb-3">Distribuição por Bioma</h4>

                            <div class="flex flex-col md:flex-row items-center gap-6">
                                <div id="bioma-pie" class="pie w-64 md:w-80" aria-hidden="true"></div>

                                <ul id="bioma-pie-legend" class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-sm w-full md:w-auto"></ul>
                            </div>

                            <!-- line chart placeholder (será gerado por JS) -->
                            <div id="bioma-line" class="bioma-line mt-6 w-full"></div>
                           
                            <div id="bioma-radar" class="bioma-radar mt-6 w-full">
                                <h4 class="text-lg font-semibold text-gray-700 mb-3">Radar Comparativo por Bioma</h4>
                                <div class="flex items-center justify-center">
                                    <div id="bioma-radar-chart" class="radar w-64 md:w-80" aria-hidden="true"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="bg-white p-6 rounded-xl shadow-md">
                <h3 class="text-xl font-bold text-gray-800 mb-4">Linha do Tempo do Desmatamento</h3>

                <div class="timeline-modern max-w-5xl mx-auto">
