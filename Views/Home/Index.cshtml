<!-- Mapa do Desmatamento -->
<section id="mapa" class="py-16 bg-gray-100">
    <div class="container mx-auto px-4">
        <h2 class="text-3xl font-bold text-center mb-6 text-gray-800">Mapa do Desmatamento no Brasil</h2>
        <p class="text-center text-gray-600 max-w-2xl mx-auto mb-12">
            Explore nosso mapa interativo para ver as áreas mais afetadas pelo desmatamento.
        </p>
        <div class="bg-white p-4 rounded-xl shadow-lg">

            <!-- Mini Mapa em 3d -->
            <div class="text-center">
                <div id="mapPreview" style="height:700px;width:700px;margin:auto;border-radius:50%;overflow:hidden;"></div> <!--Aumenta e diminui o tamanho do Globo-->

                <a asp-controller="Mapa" asp-action="Index"
                   class="inline-block mt-4 bg-green-600 text-white px-6 py-2 rounded-lg hover:bg-green-700 transition">
                    Ver mapa completo
                </a>
            </div>

            <link href="https://unpkg.com/maplibre-gl/dist/maplibre-gl.css" rel="stylesheet" />
            <script src="https://unpkg.com/maplibre-gl/dist/maplibre-gl.js"></script>

            <script>
                const map = new maplibregl.Map({
                  container: 'mapPreview',
                  style: 'https://demotiles.maplibre.org/globe.json',
                  center: [-52.8, -14.2],
                  zoom: 3.5
                });

                map.on('load', () => {
                  map.addSource('desmatamento', {
                    type: 'geojson',
                    data: '/meuarquivo4.json'
                  });

                  // camada de extrusão 3D (bem visível)
                  map.addLayer({
                    id: 'areas-desmatadas-extrusao',
                    type: 'fill-extrusion',
                    source: 'desmatamento',
                    paint: {
                      'fill-extrusion-color': '#ff4d4d',
                      'fill-extrusion-opacity': 0.85,
                      'fill-extrusion-height': 500000   // altura das colunas
                    }
                  });

                  // contorno forte vermelho
                  map.addLayer({
                    id: 'areas-desmatadas-borda',
                    type: 'line',
                    source: 'desmatamento',
                    paint: {
                      'line-color': '#cc0000',
                      'line-width': 5.5
                    }
                  });

                  // popup com informações
                  map.on('click', 'areas-desmatadas-extrusao', (e) => {
                    const props = e.features[0].properties;
                    const info = Object.entries(props)
                      .map(([k, v]) => `<b>${k}</b>: ${v}`)
                      .join('<br>');
                    new maplibregl.Popup()
                      .setLngLat(e.lngLat)
                      .setHTML(info)
                      .addTo(map);
                  });
                });
            </script>

            <!-- métricas -->
            <div class="mt-6 grid grid-cols-1 md:grid-cols-3 gap-6">
                <div class="bg-white p-4 rounded-lg border border-gray-200 shadow-sm">
                    <h4 class="font-bold text-gray-800 mb-2">Região Norte</h4>
                    <div class="h-2 bg-gray-200 rounded-full mb-2">
                        <div class="h-2 bg-red-600 rounded-full" style="width: 78%"></div>
                    </div>
                    <p class="text-sm text-gray-600">78% da área desmatada</p>
                </div>
                <div class="bg-white p-4 rounded-lg border border-gray-200 shadow-sm">
                    <h4 class="font-bold text-gray-800 mb-2">Centro-Oeste</h4>
                    <div class="h-2 bg-gray-200 rounded-full mb-2">
                        <div class="h-2 bg-yellow-500 rounded-full" style="width: 45%"></div>
                    </div>
                    <p class="text-sm text-gray-600">45% da área desmatada</p>
                </div>
                <div class="bg-white p-4 rounded-lg border border-gray-200 shadow-sm">
                    <h4 class="font-bold text-gray-800 mb-2">Outras Regiões</h4>
                    <div class="h-2 bg-gray-200 rounded-full mb-2">
                        <div class="h-2 bg-blue-500 rounded-full" style="width: 32%"></div>
                    </div>
                    <p class="text-sm text-gray-600">32% da área desmatada</p>
                </div>
            </div>
        </div>
    </div>
</section>

